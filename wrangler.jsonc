{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker in the dashboard, or deploy creates a second one.
  "name": "pomodoro-timer",
  "main": "src/index.js",
  "compatibility_date": "2025-04-01",
  // Serve on <name>.<subdomain>.workers.dev without enabling it by hand.
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /r/<room> is a client-side route, so unmatched paths serve index.html.
    "not_found_handling": "single-page-application",
    // ...but the sync endpoint must reach the Worker, not the SPA fallback.
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "TimerRoom" },
      { "name": "INDEX", "class_name": "RoomIndex" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TimerRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["RoomIndex"] }
  ],
  "observability": {
    "enabled": true
  }
}
